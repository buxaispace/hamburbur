<Project>
    <Target Name="NormalizeHintPathsForLinux" BeforeTargets="DropMissingHintPathReferences;ResolveAssemblyReferences">
        <ItemGroup>
            <Reference Condition="'%(Reference.HintPath)' != ''">
                <HintPath>$([System.String]::Copy('%(Reference.HintPath)').Replace('\', '/'))</HintPath>
            </Reference>
        </ItemGroup>
    </Target>
    <Target Name="DropMissingHintPathReferences" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <Reference Remove="@(Reference)" Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" />
        </ItemGroup>
    </Target>
</Project>
